            ("Number of Pockels cells / drivers", self.sp_n), ("Edit cell", self.cb_cell),
            ("X1 (SYNC IN1) comes from", self.cb_a)])
        grid = self.left.itemAt(self.left.count() - 1).widget().layout()
        grid.addWidget(self.lab_b, 3, 0)
        grid.addWidget(self.cb_b, 3, 1)
        info = QLabel("OUT0, OUT2, OUT3, OUT4, OUT5 have connectors on the TG10. OUT1, OUT6, OUT7 are internal only "
                      "and are not offered.")
        info.setWordWrap(True)
        info.setStyleSheet("color:#5a7085;")
        self.left.addWidget(info)

        # 3. pulse timing
        self.sp_rise = self._spin(0.025, 150e6, 100, 3, " ns", self._timing_edited)
        self.sp_width = self._spin(4, 150e6, 500, 3, " ns", self._timing_edited)
        self.sp_rise2 = self._spin(0.025, 150e6, 600, 3, " ns", self._timing_edited)
        self.sp_dur = self._spin(0.0, 150e6, 500, 3, " ns", self._dur_edited)
