                         ("Fill Output card (GUI only)", lambda: self.fill_output_card(False)),
                         ("Send Output conditions", lambda: self.fill_output_card(True)),
                         ("Send to TG10 (hardware)", self.send_to_tg10)):
            b = QPushButton(text)
            b.setMinimumHeight(32)
            b.clicked.connect(fn)
            bl.addWidget(b)
        right.addLayout(bl)

    # ---------------- model ----------------
    def active_cells(self):
        return self.cells[:self.sp_n.value()]

    def cur_cell(self):
        return self.cells[min(self.sel, self.sp_n.value() - 1)]

    def fsys(self, ch):
        try:
            return float(self.pw.system_clock_hz(ch))
        except Exception:
            return 3e9

    def step(self, ch):
        return BASE_STEP_NS[ch] * 3e9 / self.fsys(ch)

    def snap(self, v, ch):
        s = self.step(ch)
        return round(v / s) * s

    def real_w(self, ch, w):
        tick = 1e9 / self.fsys(ch)
        return max(4.0, round(w / tick) * tick)

    @property
    def cab1(self):
        return self.sp_c1.value() * CABLE_NS_PER_M

    @property
    def cab2(self):
        return self.sp_c2.value() * CABLE_NS_PER_M

    def edges(self, c):
        """Realized TG10 edges: (r1, f1, r2, f2). r2/f2 None in X1-only mode."""
        r1 = self.snap(c["rise"], c["a"])
        if self.mode == 1:
            return r1, r1 + self.real_w(c["a"], c["width"]), None, None
        f1 = r1 + self.real_w(c["a"], c["trig"])
        r2 = self.snap(c["rise2"], c["b"])
        return r1, f1, r2, r2 + self.real_w(c["b"], c["trig"])

    def hv_window(self, c):
        """(HV ON trigger time, HV OFF trigger time) at the driver inputs."""
        r1, f1, r2, f2 = self.edges(c)
        if self.mode == 1:
            return r1 + self.cab1, f1 + self.cab1
        return r1 + self.cab1, r2 + self.cab2

    def regen_n(self, c):
        """Number of X1 pulses. 1 unless pulse regeneration is on (X2 must follow the last X1 by >100 ns)."""
        if self.mode != 2 or not self.ck_regen.isChecked():
            return 1
        on, off = self.hv_window(c)
        D = off - on
        return int((D - DRV["min_w"]) // self.sp_gap.value()) + 1 if D > DRV["min_w"] else 1

    def vcell(self):
        return min(2 * self.sp_rail.value(), DRV["vout_kv"])

    def tr_tf(self):
        sc = max(1.0, self.sp_cap.value() / 6.0)
        return DRV["tr"] * sc, DRV["tf"] * sc

    def cfg2(self, k):
        """True when period k (0 = first period after trigger) runs Config 2 (fire)."""
        m = self.cb_cfg.currentIndex()
        n = self.sp_cnt.value()
        high = self.cb_level.currentIndex() == 0
        if m == 0:
            return True
        if m == 1:
            return high
        if m == 2:
            return not high
        if m == 3:
            return k < n
        return k % n == 0

    def hv_at(self, c, t):
        on, off = self.hv_window(c)
        on, off = on + self.sp_ddel.value(), off + self.sp_ddel.value()
        dur = off - on
        if dur <= 0:
            return 0.0
        tr, tf = self.tr_tf()
        V = self.vcell()
        P = self.period
        k0 = math.floor((t - on) / P)
        v = 0.0
        for k in (k0, k0 - 1):
            if k < 0 or not self.cfg2(k):
                continue
            x = t - (on + k * P)
            if x < 0:
                continue
            if x < tr:
                v += V * x / tr
            elif x < dur:
                v += V
            elif x < dur + tf:
                v += V * (1 - (x - dur) / tf)
        return v

    def transmission(self, v):
        return math.sin(math.pi / 2 * v / self.sp_vfull.value()) ** 2

    def optical_window(self, c):
        on, off = self.hv_window(c)
        on, off = on + self.sp_ddel.value(), off + self.sp_ddel.value()
        tr, tf = self.tr_tf()
        V, Vf = self.vcell(), self.sp_vfull.value()
        if V < Vf / 2 or off <= on:
            return None, None
        q = (Vf / 2) / V
        return on + tr * q, off + tf * (1 - q)

    # ---------------- lanes for the scope ----------------
    def lanes(self):
        L = [dict(kind="trig", label="TRIG (T0)", col="#e6e6e6"),
             dict(kind="cfg", label="CONFIG ACTIVE", col="#9fd8a8")]
        m = self.cb_cfg.currentIndex()
        if m in (1, 2):
            L.append(dict(kind="gate", label="GATE IN", col="#e2c04a", level=self.cb_level.currentIndex() == 0))
        for i, c in enumerate(self.active_cells()):
            r1, f1, r2, f2 = self.edges(c)
            col = LANE_COL[i % len(LANE_COL)]
            n_x1 = self.regen_n(c)
            gp = self.sp_gap.value()
            L.append(dict(kind="dig", label=f"Cell {i+1} · X1 = OUT{c['a']}" + (f" ×{n_x1}" if n_x1 > 1 else ""),
                          col=col, edge=(r1, f1), sel=(i == self.sel), tail=f1 + (n_x1 - 1) * gp,
                          train=(n_x1, gp)))
            if self.mode == 2:
                L.append(dict(kind="dig", label=f"Cell {i+1} · X2 = OUT{c['b']}", col=col, edge=(r2, f2),
                              sel=(i == self.sel), tail=f2))
            tail = self.hv_window(c)[1] + 100
            L.append(dict(kind="hv", label=f"Cell {i+1} · PCD OUTPUT + (red) / − (blue)", col="#ff7878", cell=c,
                          vmax=max(self.vcell(), 1e-6) * 1.1, tail=tail))
            if i == self.sel:
                L.append(dict(kind="opt", label=f"Cell {i+1} · light passes (0-100 %)", col="#5ad9ff", cell=c, tail=tail))
        return L

    # ---------------- events ----------------
    def _mode_changed(self, *_):
        if self._busy:
            return
        self.mode = 1 if self.r1.isChecked() else 2
        self._busy = True
        if self.mode == 2:
            self.sp_n.setMaximum(2)
            pairs = [(0, 2), (3, 4)]
            for i, (a, b) in enumerate(pairs):
                self.cells[i]["a"], self.cells[i]["b"] = a, b
                self.cells[i]["rise2"] = self.cells[i]["rise"] + max(self.cells[i]["width"], 100.0)
        else:
            self.sp_n.setMaximum(5)
        self._busy = False
        self._fill_cell_combo()
        self._load_cell_ui()
        self.refresh()

    def _count_changed(self, *_):
        if self._busy:
            return
        self._fill_cell_combo()
        self.refresh()

    def _fill_cell_combo(self):
        self._busy = True
        self.cb_cell.clear()
        for i in range(self.sp_n.value()):
            self.cb_cell.addItem(f"Pockels cell {i+1}")
        self.sel = min(self.sel, self.sp_n.value() - 1)
        self.cb_cell.setCurrentIndex(self.sel)
        self._busy = False

    def _cell_selected(self, i):
        if self._busy or i < 0:
            return
        self.sel = i
        self._load_cell_ui()
        self.refresh()

    def _chan_changed(self, *_):
        if self._busy:
            return
        c = self.cur_cell()
        c["a"] = self.cb_a.currentData()
        c["b"] = self.cb_b.currentData()
        self.refresh()

    def _load_cell_ui(self):
        c = self.cur_cell()
        self._busy = True
        self.cb_a.setCurrentIndex(self.cb_a.findData(c["a"]))
        self.cb_b.setCurrentIndex(self.cb_b.findData(c["b"]))
        self.sp_rise.setValue(c["rise"])
        self.sp_width.setValue(c["width"])
        self.sp_rise2.setValue(c["rise2"])
        self.sp_dur.setValue(max(c["rise2"] - c["rise"], 0.0))
        self.sp_trig.setValue(c["trig"])
        two = self.mode == 2
        self.cb_b.setVisible(two)
        self.lab_b.setVisible(two)
        for w in (self.lab_width, self.sp_width):
            w.setVisible(not two)
        for w in (self.lab_rise2, self.sp_rise2, self.lab_dur, self.sp_dur, self.lab_trig, self.sp_trig,
                  self.ck_regen, self.lab_gap, self.sp_gap):
            w.setVisible(two)
        self._busy = False

    def _timing_edited(self, *_):
        if self._busy:
            return
        c = self.cur_cell()
        c["rise"], c["width"] = self.sp_rise.value(), self.sp_width.value()
        c["rise2"], c["trig"] = self.sp_rise2.value(), self.sp_trig.value()
        self._busy = True
        self.sp_dur.setValue(max(c["rise2"] - c["rise"], 0.0))
        self._busy = False
        self.refresh()

    def _dur_edited(self, *_):
        if self._busy:
            return
        c = self.cur_cell()
        c["rise"] = self.sp_rise.value()
        c["rise2"] = c["rise"] + self.sp_dur.value()
        self._busy = True
        self.sp_rise2.setValue(c["rise2"])
        self._busy = False
        self.refresh()

    def _cfg_changed(self, *_):
        m = self.cb_cfg.currentIndex()
        self.lab_cnt.setText({3: "Burst count (pulses per burst)", 4: "Divide by N (1 fire period in N)"}.get(m, "Count (used by Burst / Divider)"))
        self.sp_cnt.setEnabled(m in (3, 4))
        self.cb_level.setEnabled(m in (1, 2))
        self.refresh()

    def _view_edit(self, *_):
        if self._busy:
            return
        self.ns_per_div, self.center = self.sp_div.value(), self.sp_ctr.value()
        self.scope.update()

    def _scope_moved(self):
        self._busy = True
        self.sp_div.setValue(self.ns_per_div)
        self.sp_ctr.setValue(self.center)
        self._busy = False
        self._cursor_text()

    def _set_view(self, c, npd):
        self.center, self.ns_per_div = c, max(0.05, npd)
        self._scope_moved()
        self.scope.update()

    def autoset(self):
        end = max([self.hv_window(c)[1] + self.sp_ddel.value() + self.tr_tf()[1] * 2 for c in self.active_cells()] + [self.period])
        span = end * 1.1
        self._set_view(span / 2 - 0.05 * span, span / 10)

    def zoom_hv(self):
        on, off = self.hv_window(self.cur_cell())
        span = max(off - on, 20.0) * 2.2
        self._set_view((on + off) / 2 + self.sp_ddel.value(), span / 10)

    def cur_hv(self):
        on, off = self.hv_window(self.cur_cell())
        self.cur1, self.cur2 = on + self.sp_ddel.value(), off + self.sp_ddel.value()
        self._cursor_text()
        self.scope.update()

    def cur_period(self):
        self.cur1, self.cur2 = 0.0, self.period
        self._cursor_text()
        self.scope.update()

    def _cursor_text(self):
        dx = self.cur2 - self.cur1
        self.lab_cur.setText(
            f"<span style='color:#1b9ad1'><b>X1</b> {fmt_ns(self.cur1)}</span> &nbsp; "
            f"<span style='color:#c2368f'><b>X2</b> {fmt_ns(self.cur2)}</span> &nbsp; "
            f"<b>ΔX</b> {fmt_ns(dx)} &nbsp; <b>1/ΔX</b> {fmt_hz(abs(1e9/dx)) if dx else '—'}")

    # ---------------- main-window mirroring ----------------
    def load_config_from_main(self):
        try:
            s = self.pw.config_settings["Config 1"]
        except Exception:
            return
        mode = s.get("mode", "Normal")
        self._busy = True
        if mode == "Gate":
            self.cb_cfg.setCurrentIndex(2 if s.get("gate") == "nGATE" else 1)
        elif mode == "Burst":
            self.cb_cfg.setCurrentIndex(3)
            self.sp_cnt.setValue(int(s.get("burst_count", 1)))
        elif mode == "Frequency divider":
            self.cb_cfg.setCurrentIndex(4)
            self.sp_cnt.setValue(int(s.get("divider", 1)))
        else:
            self.cb_cfg.setCurrentIndex(0)
        self._busy = False
        self._cfg_changed()

    def load_from_main(self, silent=True):
        pw = self.pw
        try:
            dd = getattr(pw, "delay_dialog", None)
            per = getattr(pw, "current_period_s", None)
            if per:
                self.sp_per.setValue(per * 1e9)
            if dd is None:
                return
            u = dd.UNIT_TO_SECONDS
            self._busy = True
            for c in self.cells:
                a, b = c["a"], c["b"]
                get = lambda f, un, i: f[i].value() * u[un[i].currentText()] * 1e9
                c["rise"] = get(dd.delay_fields, dd.delay_units, a)
                c["width"] = max(4.0, get(dd.post_delay_fields, dd.post_delay_units, a))
                c["rise2"] = get(dd.delay_fields, dd.delay_units, b)
                c["trig"] = max(4.0, get(dd.post_delay_fields, dd.post_delay_units, a))
            self._busy = False
            self._load_cell_ui()
        except Exception as exc:
            self._busy = False
            if not silent:
                QMessageBox.warning(self, "Load", f"Could not read Delay presets: {exc}")
        self.refresh()

    def _signature(self):
        pw = self.pw
        dd = getattr(pw, "delay_dialog", None)
        vals = ()
        if dd is not None:
            vals = tuple((dd.delay_fields[i].value(), dd.delay_units[i].currentText(),
                          dd.post_delay_fields[i].value(), dd.post_delay_units[i].currentText()) for i in range(8))
        cfg = getattr(pw, "config_settings", {}).get("Config 1", {})
        return (vals, tuple(sorted(cfg.items())), getattr(pw, "current_period_s", None))

    def _poll_main(self):
        if self.pw is None or not self.isVisible():
            return
        try:
            sig = self._signature()
        except Exception:
            return
        if self._sig is None:
            self._sig = sig
        elif sig != self._sig:
            old, self._sig = self._sig, sig
            if old[1] != sig[1]:
                self.load_config_from_main()
            if old[0] != sig[0] or old[2] != sig[2]:
                self.load_from_main(silent=True)

    # ---------------- checks ----------------
    def checks(self):
        ck = []
        add = lambda s, t: ck.append((s, t))
        P = self.period
        f = 1e9 / P
        if f / 1e3 > DRV["fmax_khz"]:
            add("err", f"Repetition {fmt_hz(f)} is above the {DRV['name']} limit of {DRV['fmax_khz']:.0f} kHz.")
        else:
            add("ok", f"Repetition {fmt_hz(f)} is within the {DRV['fmax_khz']:.0f} kHz driver limit.")
        used = []
        for i, c in enumerate(self.active_cells()):
            n = f"Cell {i+1}"
            used.extend(self.chain_channels(c))
            r1, f1, r2, f2 = self.edges(c)
            on, off = self.hv_window(c)
            D = off - on
            if self.mode == 1:
                if D < DRV["min_w"]:
                    add("err", f"{n}: HV pulse {fmt_ns(D)} is shorter than 100 ns - driver may be damaged. Make X1 wider.")
                elif D > DRV["max_w"]:
                    add("warn", f"{n}: HV pulse {fmt_ns(D)} is longer than 5000 ns. Use TWO pulses (X1+X2) for long HV.")
                else:
                    add("ok", f"{n}: HV pulse {fmt_ns(D)} is inside 100…5000 ns.")
            else:
                used.append(c["b"])
                if c["a"] == c["b"]:
                    add("err", f"{n}: X1 and X2 use the same output OUT{c['a']}. Pick two different outputs.")
                if D <= 0:
                    add("err", f"{n}: X2 comes before X1 - HV would never switch off. Make X2 delay larger than X1 delay.")
                elif D < DRV["min_w"]:
                    add("err", f"{n}: X2 − X1 = {fmt_ns(D)} is below 100 ns - driver may be damaged.")
                elif D > DRV["max_w"] and not self.ck_regen.isChecked():
                    add("warn", f"{n}: X2 − X1 = {fmt_ns(D)} is above 5000 ns. Tick 'Pulse regeneration'.")
                elif D > DRV["max_w"]:
                    add("ok", f"{n}: {fmt_ns(D)} HV ON time is allowed with pulse regeneration.")
                else:
                    add("ok", f"{n}: X2 − X1 = {fmt_ns(D)} is inside 100…5000 ns.")
                for nm, w in (("X1", f1 - r1), ("X2", f2 - r2)):
                    if w <= DRV["min_trig"]:
                        add("err", f"{n}: {nm} trigger pulse {fmt_ns(w)} must be longer than 20 ns.")
                nx = self.regen_n(c)
                if nx > 1:
                    gp = self.sp_gap.value()
                    if f1 - r1 >= gp:
                        add("err", f"{n}: X1 pulse width {fmt_ns(f1-r1)} is not shorter than the repeat interval {fmt_ns(gp)}.")
                    add("info", f"{n}: {nx} X1 pulses every {fmt_ns(gp)}, then X2 {fmt_ns(D-(nx-1)*gp)} after the last one (needs >100 ns).")
                    if nx > 5:
                        add("err", f"{n}: {nx} X1 pulses needed, but the TG10 OR chain gives at most 5. Increase the repeat interval (≤ 5000 ns).")
                    elif c["a"] != 5:
                        add("err", f"{n}: regeneration builds X1 on OUT5 (OR chain OUT1→OUT5). Set X1 to OUT5.")
                    else:
                        add("info", f"{n}: X1 train = OUT{self.chain_channels(c)[0]}…OUT5 OR-combined (OUT1 is internal).")
                if abs(self.cab2 - self.cab1) > 0.5:
                    add("warn", f"{n}: X1/X2 cables differ by {fmt_ns(abs(self.cab2-self.cab1))}. Use equal lengths.")
            if off + self.sp_ddel.value() + self.tr_tf()[1] > P:
                add("warn", f"{n}: HV pulse runs past one period ({fmt_ns(P)}) and overlaps the next one.")
            to, tc = self.optical_window(c)
            if to is None:
                add("warn", f"{n}: cell never opens (HV {self.vcell():.2f} kV is below half of the full-open {self.sp_vfull.value():.2f} kV).")
            else:
                add("info", f"{n}: light gate opens at {fmt_ns(to)}, closes at {fmt_ns(tc)} (window {fmt_ns(tc-to)}).")
        dup = sorted({o for o in used if used.count(o) > 1})
        if dup:
            add("err", "Output(s) " + ", ".join(f"OUT{o}" for o in dup) + " used twice. Each X input needs its own TG10 output.")
        vr, V, Vf = self.sp_rail.value(), self.vcell(), self.sp_vfull.value()
        um = 1.4 if self.cb_umax.currentIndex() == 0 else 2.5
        if vr > um + 1e-9:
            add("err", f"Rail ±{vr:.2f} kV is above the HVS-100 option Umax ±{um} kV.")
        elif vr < 0.4 * um - 1e-9:
            add("err", f"Rail ±{vr:.2f} kV is below the HVS-100 control limit (40 % of Umax = {0.4*um:.2f} kV).")
        else:
            add("ok", f"Rail ±{vr:.2f} kV is inside the HVS-100 control range ({0.4*um:.2f}…{um} kV).")
        if um > DRV["rail_kv"]:
            add("warn", f"The ±{um} kV option can exceed the {DRV['name']} limit of ±{DRV['rail_kv']} kV. Tune the rail to ≤ {DRV['rail_kv']} kV.")
        if vr > DRV["rail_kv"] + 1e-9:
            add("err", f"Rail ±{vr:.2f} kV is above the driver maximum ±{DRV['rail_kv']} kV.")
        if V < 0.98 * Vf:
            add("warn", f"Cell voltage {V:.2f} kV is below full-open {Vf:.2f} kV: light only {self.transmission(V)*100:.0f} % at peak.")
        elif V > 1.02 * Vf:
            add("warn", f"Cell voltage {V:.2f} kV is above full-open {Vf:.2f} kV: over-driven.")
        else:
            add("ok", f"Cell voltage {V:.2f} kV ≈ full-open {Vf:.2f} kV.")
        C = self.sp_cap.value()
        if C < 4:
            add("err", f"Load {C:.1f} pF is below 4 pF - driver must not run unloaded.")
        elif C > 10:
            add("warn", f"Load {C:.1f} pF is above 10 pF - derate voltage / rate.")
        pw_ = f * C * 1e-12 * (V * 1e3) ** 2 * len(self.active_cells())
        add("err" if pw_ > DRV["pmax"] else "ok", f"Estimated HV dissipation ≈ {pw_:.1f} W (driver limit ≈ {DRV['pmax']:.0f} W per driver).")
        add("info", "Config 1 = idle (no HV pulse), Config 2 = fire. Set Output card: rise = DELx, fall = post DELx "
                    "for X1; use 'Fill Output card' to do it.")
        add("info", "Operate in this order: 24 V + HV on first, then RUN on the TG10. Stop RUN before powering down.")
        return ck

    # ---------------- refresh ----------------
    def refresh(self, *_):
        if self._busy:
            return
        self.period = self.sp_per.value()
        c = self.cur_cell()
        r1, f1, r2, f2 = self.edges(c)
        on, off = self.hv_window(c)
        to, tc = self.optical_window(c)
        h = f"<b style='color:#0b4778'>Cell {self.sel+1} readout</b><br>"
        h += (f"X1 = OUT{c['a']}: rise delay <b>{fmt_ns(r1)}</b> · fall delay <b>{fmt_ns(f1)}</b> · "
              f"pulse width <b>{fmt_ns(f1-r1)}</b><br>")
        if self.mode == 2:
            h += (f"X2 = OUT{c['b']}: rise delay <b>{fmt_ns(r2)}</b> · fall delay <b>{fmt_ns(f2)}</b> · "
                  f"pulse width <b>{fmt_ns(f2-r2)}</b><br>"
                  f"Rising-edge difference X2 − X1 = <b>{fmt_ns(r2-r1)}</b> → HV ON time <b>{fmt_ns(off-on)}</b><br>")
        if self.regen_n(c) > 1:
            h += f"Regeneration: <b>{self.regen_n(c)}</b> X1 pulses every <b>{fmt_ns(self.sp_gap.value())}</b>, X2 once at the end.<br>"
        h += (f"HV on cell: ON at <b>{fmt_ns(on+self.sp_ddel.value())}</b>, OFF at <b>{fmt_ns(off+self.sp_ddel.value())}</b> "
              f"(driver delay ≈ {fmt_ns(self.sp_ddel.value())}) · "
              f"light window <b>{fmt_ns(tc-to) if to is not None else '—'}</b>")
        self.lab_read.setText(h)
        ck = self.checks()
        worst = "ok"
        for s, _t in ck:
            if s == "err":
                worst = "err"
            elif s == "warn" and worst != "err":
                worst = "warn"
        msg = {"ok": "READY - values are inside the driver limits", "warn": "CHECK - read the warnings below",
               "err": "NOT SAFE - fix the red items before sending"}[worst]
        self.lab_banner.setText(f"<b style='color:{SEV_COL[worst]}; font-size:14px'>{SEV_ICON[worst]} {msg}</b> "
                                f"&nbsp;·&nbsp; {'X1 only' if self.mode == 1 else 'X1 + X2'} · {fmt_hz(1e9/self.period)} "
                                f"· HV {self.vcell():.2f} kV")
        self.lab_chk.setText("<br>".join(f"<span style='color:{SEV_COL[s]}'><b>{SEV_ICON[s]}</b> {t}</span>" for s, t in ck))
        self._cursor_text()
        self.scope.update()

    # ---------------- hardware / main-window actions ----------------
    def chain_channels(self, c):
        """TG10 outputs that make X1. One output normally; with regeneration the OR chain …OUT4→OUT5 (ends at OUT5)."""
        n = self.regen_n(c)
        return [c["a"]] if n <= 1 else list(range(6 - min(n, 5), 6))

    def _transfer_list(self):
        """(output, rise_ns, post_width_ns, logic) for every TG10 output used."""
        out = []
        gap = self.sp_gap.value()
        for c in self.active_cells():
            if self.mode == 1:
                out.append((c["a"], c["rise"], c["width"], "NA"))
                continue
            n = self.regen_n(c)
            if n > 1:
                for j, ch in enumerate(self.chain_channels(c)):
                    out.append((ch, c["rise"] + j * gap, c["trig"], "NA" if j == 0 else "OR"))
            else:
                out.append((c["a"], c["rise"], c["trig"], "NA"))
            out.append((c["b"], c["rise2"], c["trig"], "NA"))
        return out

    def _get_delay_dialog(self):
        pw = self.pw
        dd = getattr(pw, "delay_dialog", None)
        if dd is None:
            DelayDialog = getattr(sys.modules.get("__main__"), "DelayDialog", None)
            if DelayDialog is None:
                return None
            dd = DelayDialog(pw)
            pw.delay_dialog = dd
        return dd

    def read_from_tg10(self):
        """Read DEL / post-DEL back from the TG10 (via the Delay presets dialog) and load them here."""
        pw = self.pw
        if pw is None or not getattr(pw, "connection_state", False):
            QMessageBox.warning(self, "TG10", "TG10 is not connected.")
            return
        dd = self._get_delay_dialog()
        if dd is None:
            return
        dd.load_delay_presets_from_hardware()
        self.load_from_main(silent=False)
        try:
            pw.set_status("HV Pulse Studio: values read back from TG10")
        except Exception:
            pass

    def _push_to_delay_dialog(self):
        dd = self._get_delay_dialog()
        if dd is None:
            return
        for ch, rise, width, _lg in self._transfer_list():
            for fld, unit, val in ((dd.delay_fields[ch], dd.delay_units[ch], rise),
                                   (dd.post_delay_fields[ch], dd.post_delay_units[ch], width)):
                unit.setCurrentText("ns")
                fld.setValue(val)

    def _interlock_ok(self):
        if self.ck_hv_ready.isChecked():
            return True
        QMessageBox.warning(self, "Interlock",
                            "Tick the interlock box first: HVS-100 ON at the set voltage, 24 V ON, load connected.\n\n"
                            "SYNC pulses must never reach the driver before HV and 24 V are up.")
        return False

    def send_to_tg10(self):
        if not self._interlock_ok():
            return
        pw = self.pw
        if pw is None or not getattr(pw, "connection_state", False) or getattr(pw, "serial_connection", None) is None:
            QMessageBox.warning(self, "TG10", "TG10 is not connected. Use COM in the main window first.")
            return
        for c in self.active_cells():
            n = self.regen_n(c)
            if n > 1 and (n > 5 or c["a"] != 5):
                QMessageBox.warning(self, "Pulse regeneration",
                                    "Regeneration on the TG10 needs X1 = OUT5 and at most 5 pulses "
                                    "(OUT1→OUT2→OUT3→OUT4→OUT5 OR chain).")
                return
        errs = [t for s, t in self.checks() if s == "err"]
        if errs:
            box = QMessageBox(self)
            box.setIcon(QMessageBox.Warning)
            box.setWindowTitle("Driver limits violated")
            box.setText("Driver limits are violated:\n\n" + "\n".join("✖ " + e for e in errs[:8]) +
                        "\n\nSend anyway?")
            box.setStandardButtons(QMessageBox.Yes | QMessageBox.No)
            box.setDefaultButton(QMessageBox.No)
            if box.exec() != QMessageBox.Yes:
                return
        try:
            self._push_to_delay_dialog()
            for ch, rise, width, _lg in self._transfer_list():
                f = self.fsys(ch)
                seq = pw.operations.build_delay_channel(ch, rise * 1e-9, f)
                pw.can_backend.send_sequence(pw.serial_connection, seq, label=f"DEL{ch} = {rise:.3f} ns")
                pw.menu.update_current_config(seq)
                seq, actual = pw.operations.build_post_delay_channel(ch, width * 1e-9, f)
                pw.can_backend.send_sequence(pw.serial_connection, seq, label=f"POST DEL{ch}")
                pw.menu.update_current_config(seq)
            extra = ("\n\nRegeneration uses the OR chain OUT1→OUT5 (manual: up to 5 pulses). Confirm on a scope "
                     "that OUT5 shows the full pulse train." if any(self.regen_n(c) > 1 for c in self.active_cells()) else "")
            QMessageBox.information(self, "TG10", "DEL and post-DEL values sent. Output rise/fall conditions: "
                                                  "use 'Send Output conditions' (or the Output card Set) so OUTx rise = DELx, fall = post DELx." + extra)
            pw.set_status("HV Pulse Studio values sent to TG10")
        except Exception as exc:
            QMessageBox.critical(self, "Send failed", f"Could not program TG10:\n\n{exc}")

    def fill_output_card(self, send=False):
        """Fill the main-window Output card for every used output. send=True also writes it to the TG10."""
        pw = self.pw
        try:
            if send:
                if not self._interlock_ok():
                    return
                if not getattr(pw, "connection_state", False):
                    QMessageBox.warning(self, "TG10", "TG10 is not connected.")
                    return
                if QMessageBox.question(
                        self, "Send Output conditions",
                        "This writes the Output rise/fall conditions to the TG10.\n"
                        "The main-window Output Set uses command_on=True, so check what that does on your "
                        "unit. Switch the HV and 24 V on BEFORE pulses can start.\n\nSend now?",
                        QMessageBox.Yes | QMessageBox.No, QMessageBox.No) != QMessageBox.Yes:
                    return
            for ch, _r, _w, lg in self._transfer_list():
                pw.output_channel.setCurrentText(f"OUT{ch}")
                pw.output_c1_rise.setCurrentText("No change")
                pw.output_c1_fall.setCurrentText("Force reset")
                pw.output_c2_rise.setCurrentText(f"DEL{ch}")
                pw.output_c2_fall.setCurrentText(f"post DEL{ch}")
                # Logic is NA except the OR chain used by pulse regeneration (blocked so the card does not reset it).
                pw.output_logic.blockSignals(True)
                pw.output_logic.setCurrentText(lg if ch in (2, 3, 4, 5) else "NA")
                pw.output_logic.blockSignals(False)
                if send:
                    pw._set_output_hardware()
                else:
                    pw._commit_output_to_monitor()
            pw.set_status("Output conditions " + ("sent to TG10" if send else "filled (not sent)")
                          + ": Config 2 rise = DELx, fall = post DELx; Config 1 idle")
        except Exception as exc:
            QMessageBox.warning(self, "Output card", f"Could not fill the Output card: {exc}")


