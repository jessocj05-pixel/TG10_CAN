DRV = dict(name="DPB1-1000-3.0-Al", fmax_khz=1000.0, vout_kv=3.0, rail_kv=1.5,
           tr=7.5, tf=7.5, delay=30.0, pmax=120.0, min_w=100.0, max_w=5000.0, min_trig=20.0)
USABLE = [0, 2, 3, 4, 5]          # OUT connectors on the panel (manual Fig 2.3)
INTERNAL = [1, 6, 7]              # internal only - cannot drive the driver
BASE_STEP_NS = [0.025, 0.025, 0.025, 0.025, 0.025, 9.4, 9.4, 9.4]   # at 3 GHz system clock
CABLE_NS_PER_M = 5.0
LANE_COL = ["#3ddc84", "#ffb454", "#5ad9ff", "#ff7fd1", "#b79bff", "#ff9a5a", "#4fe3d0", "#d6e04f"]
BG = QColor(5, 10, 6)
GRID = QColor(18, 48, 22)
GRID2 = QColor(29, 74, 34)
DIM = QColor(124, 156, 130)
SEV_COL = {"ok": "#119447", "warn": "#d98200", "err": "#d83b3b", "info": "#5a7085"}
SEV_ICON = {"ok": "✔", "warn": "⚠", "err": "✖", "info": "ℹ"}
CFG_MODES = ["Normal (always fire)", "GATE", "nGATE", "Burst", "Frequency divider"]


def fmt_ns(v):
    a = abs(v)
    if a >= 1e9:
        return f"{v/1e9:.3f} s"
    if a >= 1e6:
        return f"{v/1e6:.3f} ms"
    if a >= 1e3:
        return f"{v/1e3:.3f} µs"
    if a >= 1:
        return f"{v:.3f} ns"
    return f"{v*1e3:.1f} ps"


def fmt_hz(hz):
    if not math.isfinite(hz):
        return "—"
    if hz >= 1e6:
        return f"{hz/1e6:.4f} MHz"
    if hz >= 1e3:
        return f"{hz/1e3:.4f} kHz"
    return f"{hz:.3f} Hz"


def nice_step(span):
    raw = span / 10.0
    if raw <= 0:
        return 1.0
    mag = 10 ** math.floor(math.log10(raw))
    n = raw / mag
    return (1 if n < 1.5 else 2 if n < 3.5 else 5 if n < 7.5 else 10) * mag


# ------------------------------------------------------------------
# Oscilloscope-style view
# ------------------------------------------------------------------
class Scope(QWidget):
    moved = Signal()

    def __init__(self, dlg):
        super().__init__()
        self.d = dlg
        self.setMinimumHeight(420)
        self.setMouseTracking(True)
        self.setCursor(Qt.CrossCursor)
        self._drag = None

    def _win(self):
        span = self.d.ns_per_div * 10
        return self.d.center - span / 2, self.d.center + span / 2

    def ns_of(self, x):
        a, b = self._win()
        return a + x / max(self.width(), 1) * (b - a)

    def px_of(self, t):
        a, b = self._win()
        return (t - a) / (b - a) * self.width()

    def mousePressEvent(self, ev):
        mx = ev.position().x()
        if abs(mx - self.px_of(self.d.cur1)) < 8:
            self._drag = ("c1",)
        elif abs(mx - self.px_of(self.d.cur2)) < 8:
            self._drag = ("c2",)
        else:
            self._drag = ("pan", mx, self.d.center)

    def mouseMoveEvent(self, ev):
        if not self._drag:
            return
        x = ev.position().x()
        if self._drag[0] == "pan":
            self.d.center = self._drag[2] - (x - self._drag[1]) / self.width() * self.d.ns_per_div * 10
        elif self._drag[0] == "c1":
            self.d.cur1 = self.ns_of(x)
        else:
            self.d.cur2 = self.ns_of(x)
        self.moved.emit()
        self.update()

    def mouseReleaseEvent(self, ev):
        self._drag = None

    def wheelEvent(self, ev):
        a, b = self._win()
        span = b - a
        pivot = self.ns_of(ev.position().x())
        f = 1.15 if ev.angleDelta().y() < 0 else 1 / 1.15
        ns = min(1e10, max(0.5, span * f))
        start = pivot - (pivot - a) * (ns / span)
        self.d.center = start + ns / 2
        self.d.ns_per_div = ns / 10
        self.moved.emit()
        self.update()

    def paintEvent(self, _):
        d = self.d
        p = QPainter(self)
        W, H = self.width(), self.height()
        p.fillRect(0, 0, W, H, BG)
        a, b = self._win()
        span = b - a
        px = lambda t: (t - a) / span * W
        sf = QFont("Consolas", 8)
        p.setFont(sf)
        fm = QFontMetrics(sf)
        step = nice_step(span)
        t = math.ceil(a / step) * step
        while t <= b:
            strong = round(t / step) % 5 == 0
            p.setPen(QPen(GRID2 if strong else GRID, 1))
            p.drawLine(QPointF(px(t), 14), QPointF(px(t), H - 24))
            lab = fmt_ns(t)
            p.setPen(DIM)
            p.drawText(QPointF(min(max(px(t) - fm.horizontalAdvance(lab) / 2, 2), W - fm.horizontalAdvance(lab) - 2), H - 8), lab)
            t += step

        lanes = d.lanes()
        top0, avail = 24, H - 24 - 28
        lh = min(70.0, avail / max(len(lanes), 1))
        P = d.period
        for k, ln in enumerate(lanes):
            y0 = top0 + k * lh
            hi, lo = y0 + lh * 0.18, y0 + lh * 0.82
            col = QColor(ln["col"])
            p.setFont(QFont("Segoe UI", 8, QFont.Bold))
            p.setPen(col)
            p.drawText(QPointF(6, y0 + 11), ln["label"])
            kind = ln["kind"]
            klo = max(0, math.floor((a - ln.get("tail", 0.0)) / P) - 1)
            khi = max(0, math.ceil(b / P) + 1)
            if khi - klo > 1500:
                c2 = QColor(col)
                c2.setAlpha(60)
                p.fillRect(QRectF(0, hi, W, lo - hi), c2)
                p.setPen(col)
                p.drawText(QPointF(150, y0 + 11), f"{fmt_hz(1e9/P)} repetition - zoom in")
                continue
            if kind == "trig":
                for kk in range(klo, khi + 1):
                    if a <= kk * P <= b:
                        p.setPen(QPen(QColor(255, 255, 255, 150), 1.4))
                        p.drawLine(QPointF(px(kk * P), lo), QPointF(px(kk * P), hi))
            elif kind == "cfg":
                for kk in range(klo, khi + 1):
                    x1, x2 = px(kk * P), px((kk + 1) * P)
                    on = d.cfg2(kk)
                    c3 = QColor(60, 200, 110, 90) if on else QColor(120, 120, 120, 60)
                    p.fillRect(QRectF(x1 + 1, hi, max(x2 - x1 - 2, 1), lo - hi), c3)
                    if x2 - x1 > 50:
                        p.setPen(QColor(220, 235, 220))
                        p.drawText(QPointF(x1 + 6, lo - 4), "Config 2 FIRE" if on else "Config 1 idle")
            elif kind == "gate":
                y = hi if ln["level"] else lo
                p.setPen(QPen(col, 2))
                p.drawLine(QPointF(0, y), QPointF(W, y))
            elif kind == "dig":
                r, f = ln["edge"]
                cnt, gp = ln.get("train", (1, 0.0))
                path = QPainterPath()
                path.moveTo(0, lo)
                for kk in range(klo, khi + 1):
                    if not d.cfg2(kk):
                        continue
                    for j in range(cnt):
                        x1, x2 = px(r + kk * P + j * gp), px(f + kk * P + j * gp)
                        path.lineTo(x1, lo)
                        path.lineTo(x1, hi)
                        path.lineTo(x2, hi)
                        path.lineTo(x2, lo)
                path.lineTo(W, lo)
                p.setPen(QPen(col, 2.0 if ln.get("sel") else 1.5))
                p.drawPath(path)
                if ln.get("sel"):
                    for kk in range(klo, khi + 1):
                        if d.cfg2(kk):
                            x1, x2 = px(r + kk * P), px(f + kk * P)
                            if x2 - x1 > 40 and 0 < x1 < W:
                                p.setPen(QPen(QColor(255, 207, 138), 1))
                                p.drawLine(QPointF(x1, lo + 2), QPointF(x2, lo + 2))
                                p.setFont(sf)
                                p.drawText(QPointF(x1 + 3, lo + 11), f"w={fmt_ns(f - r)}")
                            break
            elif kind == "hv":
                n = max(300, W)
                mid, half = (hi + lo) / 2, (lo - hi) / 2
                pp, pn = QPainterPath(), QPainterPath()
                for i in range(n + 1):
                    tt = a + span * i / n
                    lvl = min(max(d.hv_at(ln["cell"], tt) / ln["vmax"], 0), 1.05)
                    (pp.lineTo if i else pp.moveTo)(i / n * W, mid - lvl * half)
                    (pn.lineTo if i else pn.moveTo)(i / n * W, mid + lvl * half)
                p.setPen(QPen(QColor(150, 150, 150, 90), 1))
                p.drawLine(QPointF(0, mid), QPointF(W, mid))
                p.setPen(QPen(QColor(255, 110, 110), 2.0))
                p.drawPath(pp)
                p.setPen(QPen(QColor(110, 150, 255), 2.0))
                p.drawPath(pn)
            elif kind == "opt":
                n = max(300, W)
                path = QPainterPath()
                for i in range(n + 1):
                    tt = a + span * i / n
                    lvl = d.transmission(d.hv_at(ln["cell"], tt))
                    (path.lineTo if i else path.moveTo)(i / n * W, lo - min(max(lvl, 0), 1.05) * (lo - hi))
                p.setPen(QPen(col, 2.0))
                p.drawPath(path)
        for cur, colr, lab in ((d.cur1, QColor(90, 217, 255), "X1"), (d.cur2, QColor(255, 90, 208), "X2")):
            x = px(cur)
            tri = QPainterPath()
            tri.moveTo(x - 8, 2)
            tri.lineTo(x + 8, 2)
            tri.lineTo(x, 16)
            tri.closeSubpath()
            p.fillPath(tri, colr)
            p.setPen(QPen(colr, 1.5, Qt.DashLine))
            p.drawLine(QPointF(x, 16), QPointF(x, H - 24))
            p.setPen(QColor(8, 17, 10))
            p.setFont(QFont("Consolas", 8, QFont.Bold))
            p.drawText(QPointF(x - 6, 12), lab)
        p.end()


