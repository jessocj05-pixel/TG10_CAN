        l3 = QGridLayout(g3)
        self.rows3 = []
        for i, (lab, sp) in enumerate([(self.lab_rise, self.sp_rise), (self.lab_width, self.sp_width),
                                       (self.lab_rise2, self.sp_rise2), (self.lab_dur, self.sp_dur),
                                       (self.lab_trig, self.sp_trig)]):
            lab.setWordWrap(True)
            l3.addWidget(lab, i, 0)
            l3.addWidget(sp, i, 1)
            self.rows3.append((lab, sp))
        self.lab_read = QLabel("")
        self.lab_read.setTextFormat(Qt.RichText)
        self.lab_read.setWordWrap(True)
        self.ck_regen = QCheckBox("Pulse regeneration (HV longer than 5 µs, X1+X2 only)")
        self.ck_regen.toggled.connect(self.refresh)
        self.sp_gap = self._spin(100, 5000, 4000, 1, " ns")
        self.lab_gap = QLabel("X1 repeat interval (≤ 5000 ns)")
        self.lab_gap.setWordWrap(True)
        l3.addWidget(self.ck_regen, 5, 0, 1, 2)
        l3.addWidget(self.lab_gap, 6, 0)
        l3.addWidget(self.sp_gap, 6, 1)
        self.lab_read.setMinimumHeight(130)
        self.lab_read.setAlignment(Qt.AlignTop)
        l3.addWidget(self.lab_read, 7, 0, 1, 2)
        self.left.addWidget(g3)

        # 4. config / gate
        self.cb_cfg = QComboBox()
        self.cb_cfg.addItems(CFG_MODES)
        self.cb_cfg.currentIndexChanged.connect(self._cfg_changed)
        self.cb_level = QComboBox()
        self.cb_level.addItems(["GATE IN is HIGH", "GATE IN is LOW"])
        self.cb_level.currentIndexChanged.connect(self.refresh)
        self.sp_cnt = QSpinBox()
        self.sp_cnt.setRange(1, 65535)
        self.sp_cnt.setValue(3)
        self.sp_cnt.setMinimumHeight(28)
        self.sp_cnt.valueChanged.connect(self.refresh)
        self.lab_cnt = QLabel("Burst count")
        self._group("4 · Config 1 / Config 2  and  GATE (optional)", [
            ("Config control (mirrors main window)", self.cb_cfg), ("GATE input level (simulation)", self.cb_level),
            (None, self.lab_cnt), ("Count", self.sp_cnt)])
        cnote = QLabel("Config 1 = idle (output stays LOW, no HV pulse). Config 2 = fire (pulse is generated).")
        cnote.setWordWrap(True)
        cnote.setStyleSheet("color:#5a7085;")
        self.left.addWidget(cnote)

        # 5. system
        self.sp_per = self._spin(1, 1e12, 1000, 3, " ns")
        self.cb_umax = QComboBox()
        self.cb_umax.addItems(["±1.4 kV", "±2.5 kV"])
        self.cb_umax.currentIndexChanged.connect(self.refresh)
        self.sp_rail = self._spin(0.05, 6, 1.4, 3, " kV")
        self.sp_vfull = self._spin(0.05, 20, 3.0, 3, " kV")
        self.sp_cap = self._spin(0.5, 50, 6.0, 2, " pF")
        self.sp_ddel = self._spin(0, 500, DRV["delay"], 2, " ns")
        self.sp_c1 = self._spin(0, 100, 1.0, 2, " m")
        self.sp_c2 = self._spin(0, 100, 1.0, 2, " m")
        self._group("5 · Repetition, HV supply and BBO cell", [
            ("Output period (TG10 repetition)", self.sp_per),
            ("HVS100-2X60 max voltage option (Umax)", self.cb_umax),
            ("HVS-100 rail setpoint (each of +HV / −HV)", self.sp_rail),
            ("BBO full-open voltage (datasheet)", self.sp_vfull),
            ("Cell + wiring capacitance", self.sp_cap),
            ("Driver delay X-edge → HV edge (measure or datasheet)", self.sp_ddel),
            ("X1 cable length", self.sp_c1), ("X2 cable length", self.sp_c2)])
        self.left.addStretch(1)

