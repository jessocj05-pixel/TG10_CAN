class PulseStudioDialog(QDialog):

    def __init__(self, parent=None):
        super().__init__(parent)
        self.pw = parent
        self.setWindowTitle("HV Pulse Studio — TG10 → DPB1-1000-3.0-Al → BBO Pockels cell")
        self.resize(1380, 880)
        self.setWindowFlag(Qt.WindowMaximizeButtonHint, True)

        self.period = 1000.0
        self.center, self.ns_per_div = 500.0, 100.0
        self.cur1, self.cur2 = 30.0, 230.0
        self.sel = 0
        self.mode = 1                      # 1 = X1 only, 2 = X1+X2
        self._busy = True
        self._sig = None
        self.cells = []
        for i in range(5):
            self.cells.append(dict(a=USABLE[i], b=USABLE[(i + 1) % 5], rise=100.0 + 50 * i,
                                   width=500.0, rise2=600.0 + 50 * i, trig=50.0))

        root = QHBoxLayout(self)
        sc = QScrollArea()
        sc.setWidgetResizable(True)
        sc.setFixedWidth(450)
        sc.setHorizontalScrollBarPolicy(Qt.ScrollBarAlwaysOff)
        holder = QWidget()
        self.left = QVBoxLayout(holder)
        sc.setWidget(holder)
        root.addWidget(sc)
        right = QVBoxLayout()
        root.addLayout(right, 1)
        self._build_left()
        self._build_right(right)

        self._busy = False
        self._mode_changed()
        self.load_config_from_main()
        self.load_from_main(silent=True)
        self.autoset()
        self._poll = QTimer(self)
        self._poll.timeout.connect(self._poll_main)
        self._poll.start(700)

    # ---------------- small UI helpers ----------------
    def _spin(self, lo, hi, val, dec, suf, slot=None):
        s = QDoubleSpinBox()
        s.setRange(lo, hi)
        s.setDecimals(dec)
        s.setValue(val)
        s.setSuffix(suf)
        s.setMinimumHeight(28)
        s.valueChanged.connect(slot or self.refresh)
        return s

    def _group(self, title, rows):
        g = QGroupBox(title)
        l = QGridLayout(g)
        for i, (n, w) in enumerate(rows):
            if n is None:
                l.addWidget(w, i, 0, 1, 2)
            else:
                lab = QLabel(n)
                lab.setWordWrap(True)
                l.addWidget(lab, i, 0)
                l.addWidget(w, i, 1)
        self.left.addWidget(g)
        return g

    def _outcombo(self, slot):
        c = QComboBox()
        for o in USABLE:
            c.addItem(f"OUT{o}", o)
        c.currentIndexChanged.connect(slot)
        return c

    # ---------------- left panel ----------------
    def _build_left(self):
        # 1. mode
        g = QGroupBox("1 · How is the Pockels driver triggered?")
        gl = QVBoxLayout(g)
        self.r1 = QRadioButton("ONE pulse (X1 only)\nX1 goes HIGH = HV ON, X1 goes LOW = HV OFF")
        self.r2 = QRadioButton("TWO pulses (X1 + X2)\nX1 rising edge = HV ON, X2 rising edge = HV OFF")
        self.r1.setChecked(True)
        grp = QButtonGroup(g)
        for r in (self.r1, self.r2):
            grp.addButton(r)
            gl.addWidget(r)
            r.toggled.connect(self._mode_changed)
        self.left.addWidget(g)
        note = QLabel("Match the jumper #7 on the DPB1 driver: position 1 = ONE pulse, position 2 = TWO pulses.")
        note.setWordWrap(True)
        note.setStyleSheet("color:#5a7085;")
        self.left.addWidget(note)

        # 2. cells + channels
        self.sp_n = QSpinBox()
        self.sp_n.setRange(1, 5)
        self.sp_n.setMinimumHeight(28)
        self.sp_n.valueChanged.connect(self._count_changed)
        self.cb_cell = QComboBox()
        self.cb_cell.currentIndexChanged.connect(self._cell_selected)
        self.cb_a = self._outcombo(self._chan_changed)
        self.cb_b = self._outcombo(self._chan_changed)
        self.lab_b = QLabel("X2 (SYNC IN2) comes from")
