# test_calc.py
"""
Test all calculation functions
"""

from calculations import *

print("=" * 60)
print("1. Testing parse_time()")
print("=" * 60)
print("250ns   →", parse_time("250ns"))
print("1us     →", parse_time("1us"))
print("10ms    →", parse_time("10ms"))
print("2s      →", parse_time("2s"))
print("100     →", parse_time("100"))        # default ns

print("\n" + "=" * 60)
print("2. Testing parse_freq()")
print("=" * 60)
print("1MHz    →", parse_freq("1MHz"))
print("100kHz  →", parse_freq("100kHz"))
print("20MHz   →", parse_freq("20MHz"))
print("500Hz   →", parse_freq("500Hz"))

print("\n" + "=" * 60)
print("3. Testing calc_pll2()")
print("=" * 60)
for freq in [100, 80, 50, 20, 10]:
    ndiv, vco, osc = calc_pll2(freq)
    f_sys = freq * ndiv
    print(f"{freq:3} MHz → Ndiv={ndiv:3}, VCO={'3GHz' if vco else '2.5GHz'}, "
          f"OscClock={osc}, f_sys={f_sys:.1f} MHz")

print("\n" + "=" * 60)
print("4. Testing calc_ratediv()")
print("=" * 60)
print("1 µs @ 100 MHz → Ratediv =", calc_ratediv(1e-6, 100e6))
print("10 µs @ 100 MHz → Ratediv =", calc_ratediv(10e-6, 100e6))
print("1 µs @ 20 MHz  → Ratediv =", calc_ratediv(1e-6, 20e6))

print("\n" + "=" * 60)
print("5. Testing calc_delay()  (250 ns example)")
print("=" * 60)
f_sys = 100e6
delay_cnt, d_delay, a_delay = calc_delay(parse_time("250ns"), f_sys)
print(f"250 ns @ 100 MHz → DelayCnt={delay_cnt}, Ddly={d_delay}, Adly={a_delay}")

print("\n" + "=" * 60)
print("6. Testing calc_postcnt()")
print("=" * 60)
print("50 ns @ 100 MHz → PostCnt =", calc_postcnt(parse_time("50ns"), 100e6))
print("1 us @ 100 MHz  → PostCnt =", calc_postcnt(parse_time("1us"), 100e6))

print("\n" + "=" * 60)
print("7. Full example (the way you will use it)")
print("=" * 60)

ext_mhz = 20
ndiv, vco2, osc_clock = calc_pll2(ext_mhz)
ratediv = calc_ratediv(parse_time("1us"), ext_mhz * 1e6)
delay_cnt, d_delay, a_delay = calc_delay(parse_time("250ns"), ext_mhz * 1e6)
post_cnt = calc_postcnt(parse_time("50ns"), ext_mhz * 1e6)

print(f"Ndiv      = {ndiv}")
print(f"VCO       = {vco2} ({'3GHz' if vco2 else '2.5GHz'})")
print(f"OscClock  = {osc_clock}")
print(f"Ratediv   = {ratediv}")
print(f"DelayCnt0 = {delay_cnt}")
print(f"Ddly0     = {d_delay}")
print(f"Adly0     = {a_delay}")
print(f"PostCnt0  = {post_cnt}")

print("\nReady-to-use sequence lines:")
print(f"(0x12, ({ndiv}).to_bytes(4, \"little\")),")
print(f"(0x20, ({ratediv}).to_bytes(4, \"little\")),")
print(f"(0x80, ({delay_cnt}).to_bytes(4, \"little\")),")
print(f"(0x5D, bytes([{d_delay}])),")
print(f"(0x56, bytes([{a_delay}])),")
print(f"(0x26, ({post_cnt}).to_bytes(2, \"little\")),")